#!/bin/sh
# Blocks commits that contain secrets. This repo is PUBLIC.
set -e

# 1) Never commit env files (except .env.example).
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)
if [ -n "$bad" ]; then
  echo "✗ Refusing to commit env files:" >&2
  echo "$bad" >&2
  exit 1
fi

# 2) Scan staged changes for secrets.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✗ gitleaks is not installed. Install it: brew install gitleaks" >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner --config .gitleaks.toml
