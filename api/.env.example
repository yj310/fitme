# Copy to api/.env and fill in. NEVER commit api/.env (it is git-ignored).
APP_ENV=development

# Supabase (Project Settings → API). Service role key = full DB access: server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Only needed for legacy HS256 projects. New projects verify via JWKS automatically.
SUPABASE_JWT_SECRET=

ALLOWED_ORIGINS=http://localhost:3000

# AI
GEMINI_API_KEY=your-gemini-api-key
NVIDIA_API_KEY=your-nvidia-api-key        # development only
AI_KEY_ENCRYPTION_KEY=your-32-byte-key-base64   # python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

# Weather (공공데이터포털 기상청 단기예보, 일반 인증키 Decoding 값)
KMA_SERVICE_KEY=your-kma-service-key

# Free tier limits per user per day
FREE_DAILY_AGENT_RUNS=20
FREE_DAILY_TAGGING=50
RATE_LIMIT_PER_MINUTE=30

# Development-only test accounts (created by api/scripts/seed.py). Ignored in production.
DEV_TEST_PASSWORD=your-dev-test-password
